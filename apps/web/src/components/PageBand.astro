---
// The tiled band at the top of a page. Anything passed in, such as a fish count, goes under the text.
interface Props {
	/** Small uppercase label above the heading, e.g. "Browse". */
	label: string;
	/** Makes the label a link, e.g. to the group's section on the Browse page. */
	labelHref?: string;
	heading: string;
	text: string;
}

const { label, labelHref, heading, text } = Astro.props;
---

<div class="tile-surface border-b border-grout">
	<div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
		<p class="text-xs font-semibold uppercase tracking-[0.06em] text-salt" data-band-label>
			{labelHref ? <a href={labelHref} class="tag-link">{label}</a> : label}
		</p>
		<h1 class="mt-1.5 break-words font-display text-[26px] font-bold leading-[1.15] tracking-[-0.035em] sm:text-[30px]">
			{heading}
		</h1>
		<p class="mt-2 max-w-xl text-[15px] text-muted">{text}</p>
		<slot />
	</div>
</div>
