---
import { usePath } from '../lib/categories';
import type { Use } from '../lib/fish-schema';
import { USE_SHORT_LABEL, useTagText } from '../lib/labels';

interface Props {
	uses: readonly Use[];
	size?: 'card' | 'page';
	/** Makes each use a link to its page. Never inside a card, which is already one link. */
	linked?: boolean;
	class?: string;
}

const { uses, size = 'card', linked = false, class: className } = Astro.props;
---

<span
	class:list={[
		'cardboard inline-block -rotate-[3deg] px-2.5 transition-transform duration-[400ms] ease-[cubic-bezier(.3,1.6,.5,1)]',
		size === 'card' ? 'text-sm' : 'text-base',
		className,
	]}
>
	{
		linked
			? uses.map((use, i) => (
					<>
						{i > 0 && ' · '}
						<a href={usePath(use)} class="underline-offset-2 hover:underline focus-visible:underline">{USE_SHORT_LABEL[use]}</a>
					</>
				))
			: useTagText(uses)
	}
</span>
