---
import { Picture } from 'astro:assets';
import type { Fish } from '../lib/fish-schema';
import { licenseUrl } from '../lib/format';
import { photoFor } from '../lib/photos';

type FishPhoto = NonNullable<Fish['photos']>[number];

interface Props {
	fishId: string;
	photo: FishPhoto;
	alt: string;
	/** `header` sits beside the name and loads first; `gallery` is one of the "More photos". */
	variant: 'header' | 'gallery';
	class?: string;
}

const { fishId, photo, alt, variant, class: className } = Astro.props;
const image = photoFor(fishId, photo.file);
const header = variant === 'header';
---

<figure class={className} data-hero={header ? '' : undefined} data-gallery-photo={header ? undefined : ''}>
	<Picture
		src={image}
		alt={alt}
		widths={header ? [480, 720, 960] : [400, 800]}
		sizes={header
			? '(min-width: 1152px) 460px, (min-width: 768px) 40vw, 92vw'
			: '(min-width: 1152px) 370px, (min-width: 640px) 31vw, 46vw'}
		formats={['avif', 'webp']}
		priority={header}
		class="aspect-[4/3] w-full rounded-xl border border-grout object-cover"
	/>
	<figcaption class:list={['mt-1.5 text-xs text-muted', header && 'text-right']}>
		<a href={photo.url} class="underline">
			{photo.credit}
		</a>{' '}
		·{' '}
		<a href={licenseUrl(photo.license)} class="underline">
			{photo.license}
		</a>
	</figcaption>
</figure>
