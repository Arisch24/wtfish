---
import Logo from './Logo.astro';

const links = [
	{ href: '/', label: 'Fish' },
	{ href: '/identify/', label: 'Identify' },
	{ href: '/about/', label: 'About' },
];
const trim = (path: string) => path.replace(/\/+$/, '') || '/';
const here = trim(Astro.url.pathname);
---

<header class="border-b border-grout bg-white">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-2.5 sm:px-6">
		<a href="/" aria-label="wtfish home" class="rounded-sm"><Logo /></a>
		<nav aria-label="Main">
			<ul class="flex gap-1 text-sm font-medium">
				{
					links.map(({ href, label }) => (
						<li>
							<a
								href={href}
								aria-current={trim(href) === here ? 'page' : undefined}
								class="block rounded-md px-2.5 py-1.5 text-ink hover:bg-tile aria-[current=page]:bg-salt-soft aria-[current=page]:text-salt"
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
