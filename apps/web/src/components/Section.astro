---
interface Props {
	title: string;
	/** Used for the heading id and data-section. */
	id: string;
	/** Short text on the right of the heading, e.g. "Last reviewed 13 October 2026". */
	note?: string;
	/** One line under the heading. */
	description?: string;
	class?: string;
}

const { title, id, note, description, class: className } = Astro.props;
---

<section class:list={['min-w-0 py-6', className]} aria-labelledby={id} data-section={id}>
	<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
		<h2 id={id} class="font-display text-[19px] font-bold leading-tight tracking-[-0.02em]">{title}</h2>
		{note && <p class="text-xs text-muted">{note}</p>}
	</div>
	{description && <p class="mt-1 text-[13px] text-muted">{description}</p>}
	<div class="mt-3">
		<slot />
	</div>
</section>
