---
import Icon from './Icon.astro';

interface Props {
	/** Sets the size, e.g. "text-[21px]". */
	class?: string;
}

const { class: className = 'text-[21px]' } = Astro.props;
---

<span class:list={['inline-flex items-center font-display font-bold leading-none tracking-[-0.03em] text-ink', className]}>
	<span class="text-sign-red">wt</span>fish<Icon name="hook-question" class="ml-0.5 h-[0.98em] w-[0.56em] text-sign-red" />
</span>
