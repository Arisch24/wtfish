---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { searchText, type FilterItem } from '../lib/filter';
import { photoFor } from '../lib/photos';
import CardTape from './CardTape.astro';
import Icon from './Icon.astro';
import UseTag from './UseTag.astro';
import WaterLabel from './WaterLabel.astro';

interface Props {
	fish: CollectionEntry<'fish'>;
}

const { id, data } = Astro.props.fish;
const photo = data.photos?.[0];
const stateCount = data.malaysia?.states?.length ?? 0;
const filter: FilterItem = {
	search: searchText(data.names),
	water: data.water,
	uses: data.uses,
	states: data.malaysia?.states?.map((s) => s.state) ?? [],
	status: data.malaysia?.status ?? '',
	iucn: data.iucn ?? '',
};
---

<li data-fish-card data-filter={JSON.stringify(filter)} class="h-full">
	<a
		href={`/fish/${id}/`}
		class="group panel flex h-full flex-col overflow-hidden transition-[translate,border-color] duration-200 hover:-translate-y-0.5 hover:border-hover-line"
	>
		<div class="relative">
			{
				photo ? (
					<Picture
						src={photoFor(id, photo.file)}
						alt=""
						widths={[320, 480, 640]}
						sizes="(min-width: 1152px) 280px, (min-width: 640px) 45vw, 92vw"
						formats={['avif', 'webp']}
						class="aspect-[16/10] w-full object-cover"
					/>
				) : (
					<div
						class="tile-surface flex aspect-[16/10] w-full flex-col items-center justify-center gap-2 text-muted"
						data-no-photo
					>
						<Icon name="fish" class="w-20 text-grout" />
						<span class="text-[13px] font-medium">No photo yet</span>
					</div>
				)
			}
			<UseTag uses={data.uses} class="absolute left-2 top-2 origin-left group-hover:rotate-[2deg]" />
		</div>
		<div class="flex flex-1 flex-col px-3 pb-3 pt-2.5">
			<h2 class="break-words font-display text-base font-semibold leading-tight tracking-[-0.01em]">
				{data.names.english}
			</h2>
			<p class="text-[13px] italic text-muted">{data.names.scientific}</p>
			{data.size && <CardTape maxCm={data.size.maxCm} />}
			<div class="mt-auto flex flex-wrap items-center justify-between gap-2 pt-3">
				<span class="flex flex-wrap gap-1">{data.water.map((water) => <WaterLabel water={water} />)}</span>
				{
					stateCount > 0 && (
						<span class="text-xs text-muted">
							{stateCount} {stateCount === 1 ? 'state' : 'states'}
						</span>
					)
				}
			</div>
		</div>
	</a>
</li>
