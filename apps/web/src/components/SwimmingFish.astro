---
import Icon from './Icon.astro';
---

<!-- Only the fish goes under reduced motion. The strip keeps its height for the hanging sign's line. -->
<div class="pointer-events-none relative h-9 overflow-hidden" aria-hidden="true" data-swim-strip>
	<div class="absolute top-1 animate-swim motion-reduce:hidden">
		<div class="animate-bob"><Icon name="fish" class="h-[13px] w-[52px] -scale-x-100 text-salt opacity-55" /></div>
	</div>
</div>
