---
import { getCollection } from 'astro:content';
import CategoryLinks from '../components/CategoryLinks.astro';
import FishCard from '../components/FishCard.astro';
import Base from '../layouts/Base.astro';
import { GROUPS, categoriesWithFish, fishIn, groupLinks, type Category } from '../lib/categories';

// One route for every category page, such as /habitat/mangroves/ or /threatened/.
// A category with no fish gets no page; it appears once its first fish is added.
export async function getStaticPaths() {
	const fish = await getCollection('fish');
	return categoriesWithFish(fish).map((category) => ({
		params: { category: category.path.slice(1, -1) },
		props: { category },
	}));
}

interface Props {
	category: Category;
}

const { category } = Astro.props;
const fish = await getCollection('fish');
const members = fishIn(category, fish);
const group = GROUPS[category.group];
---

<Base title={`${category.title} | wtfish`} description={category.description}>
	<div class="tile-surface border-b border-grout">
		<div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
			<p class="text-xs font-semibold uppercase tracking-[0.06em] text-salt" data-group-label>{group.label}</p>
			<h1 class="mt-1.5 break-words font-display text-[26px] font-bold leading-[1.15] tracking-[-0.035em] sm:text-[30px]">
				{category.title}
			</h1>
			<p class="mt-2 max-w-xl text-[15px] text-muted">{category.description}</p>
			{group.note && <p class="mt-2 max-w-xl text-[13px] text-muted">{group.note}</p>}
			<p class="mt-2.5 text-xs text-muted" data-fish-count>{members.length} fish</p>
		</div>
	</div>
	<div class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
		<ul class="grid grid-cols-[repeat(auto-fill,minmax(16rem,1fr))] gap-4">
			{members.map((entry) => <FishCard fish={entry} />)}
		</ul>
	</div>
	<nav aria-labelledby="group-links" class="mx-auto mt-10 max-w-6xl px-4 sm:px-6" data-group-links>
		<div class="border-t border-grout pt-6">
			<h2 id="group-links" class="font-display text-[19px] font-bold leading-tight tracking-[-0.02em]">
				{group.heading}
			</h2>
			<CategoryLinks links={groupLinks(category.group, fish)} current={category.path} class="mt-3" />
		</div>
	</nav>
</Base>
