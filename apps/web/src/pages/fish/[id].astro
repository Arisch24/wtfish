---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const fish = await getCollection('fish');
	return fish.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
	entry: CollectionEntry<'fish'>;
}

const { data } = Astro.props.entry;
---

<Base title={`${data.commonName} (${data.scientificName}) | wtfish`} description={data.summary}>
	<p><a href="/">← All fish</a></p>
	<h1>{data.commonName}</h1>
	<p class="sci">{data.scientificName}</p>
	<p>{data.summary}</p>
	<dl>
		<dt>Family</dt>
		<dd>{data.family}</dd>
		<dt>Category</dt>
		<dd class="cap">{data.category}</dd>
		<dt>Water</dt>
		<dd class="cap">{data.water}</dd>
		<dt>Max length</dt>
		<dd>~{data.maxLengthCm} cm</dd>
	</dl>
</Base>

<style>
	h1 {
		margin-bottom: 0;
	}
	.sci {
		margin-top: 0.25rem;
		font-style: italic;
		color: var(--muted);
	}
	dl {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.5rem 1.5rem;
		max-width: 28rem;
		padding: 1rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 0.75rem;
	}
	dt {
		color: var(--muted);
	}
	dd {
		margin: 0;
	}
	.cap {
		text-transform: capitalize;
	}
</style>
